# Stage 2 image (TRIAL, not for use until proven): OpenFOAM v2412 built from source for the
# x86-64-v3 level (AVX2/FMA), which every current GitHub-hosted x86 runner supports.
# Must pass before use: same car on AMD and Intel runners within 0.01 ms, and equal to the
# stage-1 image within 0.01 ms (or a re-proved noise/repeat gate if the answers shift).
FROM ubuntu:24.04 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -q && apt-get install -y -q build-essential flex bison cmake zlib1g-dev \
      libboost-system-dev libboost-thread-dev libopenmpi-dev openmpi-bin libscotch-dev \
      libptscotch-dev libfftw3-dev git curl ca-certificates
RUN curl -sL https://dl.openfoam.com/source/v2412/OpenFOAM-v2412.tgz | tar xz -C /opt
WORKDIR /opt/OpenFOAM-v2412
# -march=x86-64-v3 only: no -ffast-math (it reorders sums and breaks repeatability).
# ESI v2412 appends WM_CFLAGS / WM_CXXFLAGS to its own Opt flags (rule-file paths moved, so no sed).
RUN bash -c 'export WM_CFLAGS="-march=x86-64-v3" WM_CXXFLAGS="-march=x86-64-v3";       source etc/bashrc WM_MPLIB=SYSTEMOPENMPI; ./Allwmake -j -s -q -l'  && test -x platforms/*/bin/simpleFoam
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -q && apt-get install -y -q openmpi-bin libopenmpi3t64 libscotch-7.0 libptscotch-7.0 \
      libfftw3-double3 python3 python3-venv libopengl0 libglu1-mesa libegl1 libgl1 libgomp1 libxkbcommon0 \
      libboost-system1.83.0 libboost-thread1.83.0 && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/OpenFOAM-v2412 /opt/OpenFOAM-v2412
RUN python3 -m venv /opt/py && /opt/py/bin/pip install --no-cache-dir pytest numpy==2.4.6 scipy==1.17.1 pandas \
      trimesh==5.2.0 scikit-image shapely rtree==1.4.1 mapbox-earcut manifold3d==3.5.4 \
      fast_simplification==0.2.0 jax jaxlib matplotlib pymeshlab==2025.7.post1
ENV PATH=/opt/py/bin:$PATH FOAM_BASHRC=/opt/OpenFOAM-v2412/etc/bashrc
